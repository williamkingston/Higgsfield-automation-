# Higgsfield API credentials — copy to .env and fill in. Never commit .env.

# Required: bearer token used to authenticate API requests.
HIGGSFIELD_API_KEY=

# Optional: override the API base URL (defaults to https://api.higgsfield.ai).
HIGGSFIELD_API_BASE=https://api.higgsfield.ai

# Optional: where generated clips and job records are written (default: output).
HIGGSFIELD_OUTPUT_DIR=output

# Local LTX-Video backend (optional): path to a cloned Lightricks/LTX-Video repo.
# Only needed when a series sets `backend: ltx`.
LTX_VIDEO_DIR=/path/to/LTX-Video

# Lovart API credentials.
# Obtain an access key / secret key pair from the Lovart dashboard. Requests are
# signed with HMAC-SHA256 using the secret key; the secret key is sensitive and
# must never be committed or logged.
LOVART_ACCESS_KEY=ak_xxx
LOVART_SECRET_KEY=sk_xxx
# Optional overrides (defaults shown).
LOVART_API_BASE=https://lgw.lovart.ai
LOVART_API_PREFIX=/v1/openapi

# APILayer product credentials (src/apilayer/). Each product is signed up for
# and billed independently at its own site (weatherstack.com, fixer.io, ...)
# even though every client shares the same access_key-based auth. Only set the
# keys for the products you actually use — each client raises a clear
# ConfigError at construction if its key is missing. Every product also
# supports a `{PRODUCT}_API_BASE` override (see src/apilayer/base.py), not
# listed below since the defaults rarely need changing.
WEATHERSTACK_ACCESS_KEY=
AVIATIONSTACK_ACCESS_KEY=
FIXER_ACCESS_KEY=
CURRENCYLAYER_ACCESS_KEY=
MARKETSTACK_ACCESS_KEY=
POSITIONSTACK_ACCESS_KEY=
IPSTACK_ACCESS_KEY=
VATLAYER_ACCESS_KEY=
MAILBOXLAYER_ACCESS_KEY=
NUMVERIFY_ACCESS_KEY=
USERSTACK_ACCESS_KEY=
SERPSTACK_ACCESS_KEY=
SCRAPESTACK_ACCESS_KEY=
SCREENSHOTLAYER_ACCESS_KEY=
GIFLAYER_ACCESS_KEY=
PDFLAYER_ACCESS_KEY=
COINLAYER_ACCESS_KEY=
MEDIASTACK_ACCESS_KEY=
STREETLAYER_ACCESS_KEY=
