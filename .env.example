# Empire Ops — environment template. Copy to .env and fill in. Never commit .env.
#
# Phase 0 only requires the Airtable variables below. Other keys are listed so
# later phases (content, music, commerce, money digest) drop in without churn.

# --- State layer: Airtable "Empire Ops" base (Phase 0+) ---
# Personal access token with data.records:read/write + schema.bases:read on the base.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=applx48uo2056erUB

# --- Execution layer: Higgsfield (Phase 1 content engine) ---
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai

# --- Storage layer: Cloudinary (Phase 1 asset storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Music pipeline (Phase 2) ---
SPLICE_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# --- Commerce + reporting (Phase 3) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=

# --- Notifications (digests / approvals) ---
SLACK_WEBHOOK_URL=

# Default IANA timezone for routines (schedules, digests, timestamps).
EMPIRE_TIMEZONE=America/New_York
