# Higgsfield Cloud API credentials — get them at https://cloud.higgsfield.ai/api-keys
# Never commit your real .env (it is gitignored).

HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Alternatively, a single combined value instead of the two above:
# HIGGSFIELD_KEY=key:secret

# API base URL. Defaults to the Higgsfield Cloud platform surface.
# Override only if your account uses a different endpoint.
HIGGSFIELD_API_BASE=https://platform.higgsfield.ai/v1
