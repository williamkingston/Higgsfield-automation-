# Higgsfield API credentials
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE=https://api.higgsfield.ai

# Lovart API credentials
# Obtain an access key / secret key pair from the Lovart dashboard.
# The access key is public-ish (identifies the account); the secret key
# is sensitive and must never be committed or logged.
LOVART_ACCESS_KEY=ak_xxx
LOVART_SECRET_KEY=sk_xxx
LOVART_API_BASE=https://api.lovart.ai
